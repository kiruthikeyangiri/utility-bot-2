# ==============================================================================
# Utility Bot - Environment Configuration (.env)
# ==============================================================================

# MongoDB Database Configuration (Optional)
# Leave blank to use built-in zero-config Local JSON Store (history.json) with 30-day retention
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/utility_bot?retryWrites=true&w=majority
# Example for Local MongoDB: mongodb://localhost:27017
MONGODB_URI=

# Groq Cloud LLM API Configuration (Optional)
# Leave blank to use the built-in 100% offline Pure Local OCR Engine (RapidOCR)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq LLM Model (Optional - defaults to llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3.6-27b, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
